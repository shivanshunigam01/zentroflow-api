NODE_ENV=development
PORT=8787
RAZORPAY_API_PORT=8787

API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
JWT_SECRET=change-me-in-production
DUPLICATE_WINDOW_DAYS=30

# MongoDB Atlas (replace <db_password>)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/zentroverse?authSource=admin&retryWrites=true&w=majority&appName=Cluster0
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_HOST=cluster0.example.mongodb.net
MONGODB_DB=zentroverse

# Razorpay (server only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Surepass
SUREPASS_BASE_URL=https://kyc-api.surepass.io
SUREPASS_TOKEN=

# Admin panel
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production

# AiSensy Partner API
AISENSY_PARTNER_ID=
AISENSY_PARTNER_API_KEY=
AISENSY_SHARED_SECRET=
AISENSY_PARTNER_PLAN_FAMILY_ID=
AISENSY_PLAN_FAMILY_ID=
