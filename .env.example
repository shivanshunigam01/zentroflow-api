NODE_ENV=development
PORT=8787
RAZORPAY_API_PORT=8787

API_PREFIX=/api/v1
# CORS is open for all origins in src/config/cors.js (JWT via Authorization header)
# CORS_ORIGIN is unused — kept for reference only
CORS_ORIGIN=*
JWT_SECRET=change-me-in-production
DUPLICATE_WINDOW_DAYS=30

# MongoDB Atlas (replace <db_password>)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/zentroverse?authSource=admin&retryWrites=true&w=majority&appName=Cluster0
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_HOST=cluster0.example.mongodb.net
MONGODB_DB=zentroverse

# Razorpay (server only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Surepass
SUREPASS_BASE_URL=https://kyc-api.surepass.io
SUREPASS_TOKEN=

# Legacy env admin (still works for login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production

# Auto-created on first start if no users in DB
DEFAULT_USER_EMAIL=buddy@zentroverse.com
DEFAULT_USER_PASSWORD=Zentroflow@2026

# AiSensy Partner API
AISENSY_PARTNER_ID=
AISENSY_PARTNER_API_KEY=
AISENSY_SHARED_SECRET=
AISENSY_PARTNER_PLAN_FAMILY_ID=
AISENSY_PLAN_FAMILY_ID=

# WhatsApp bulk campaign (Lead Inbox — never expose apiKey to frontend)
WHATSAPP_CAMPAIGN_API_URL=https://backend.api-wa.co/campaign/zentroverse-global/api/v2
WHATSAPP_CAMPAIGN_API_KEY=
WHATSAPP_CAMPAIGN_NAME=flowtest
WHATSAPP_CAMPAIGN_USER_NAME=Zentroverse
WHATSAPP_CAMPAIGN_SOURCE=zentroflow-lead-inbox
WHATSAPP_CAMPAIGN_DELAY_MS=350

# Campaign report (connect.api-wa.co) — uses AISENSY_PARTNER_API_KEY + project/campaign ids
# WHATSAPP_PROJECT_ID=   # optional; auto-read from JWT id in WHATSAPP_CAMPAIGN_API_KEY
# WHATSAPP_CAMPAIGN_ID=  # optional; auto-resolved from campaign name via campaign-details API

# Max leads loaded on GET /bootstrap (inbox sync). Default 10000.
BOOTSTRAP_MAX_LEADS=10000
